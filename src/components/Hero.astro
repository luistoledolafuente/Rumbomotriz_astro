---
import Icon from "./Icon.astro";

const A = import.meta.env.PUBLIC_ASSETS_URL || '';

const slides = [
  { video: `${A}/videos/hero-1.mp4` },
  { video: `${A}/videos/hero-2.mp4` },
];
---

<section class="w-full py-20" id="inicio" aria-label="Hero principal">
  <div class="relative w-full min-h-[70vh] flex flex-col gap-8 items-center justify-center p-8 text-center overflow-hidden shadow-2xl bg-black group">
    
    <div class="absolute inset-0 w-full h-full z-0">
      {slides.map((slide, index) => (
        <div class={`video-slide absolute inset-0 w-full h-full transition-opacity duration-1000 ${index === 0 ? 'opacity-100' : 'opacity-0'}`} role="presentation">
          <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/80 z-10"></div>
          <video
            autoplay
            muted
            loop
            playsinline
            class="w-full h-full object-cover scale-105"
            aria-hidden="true"
            data-src={index !== 0 ? slide.video : undefined}
          >
            {index === 0 ? <source src={slide.video} type="video/mp4" /> : null}
          </video>
        </div>
      ))}
    </div>

    <div class="relative z-20 flex flex-col gap-6 max-w-4xl">
      <h1 class="text-white text-4xl md:text-7xl font-black leading-tight tracking-tighter drop-shadow-lg">
        Soluciones de Alto <span class="text-primary">Rendimiento</span><br />
        <span class="text-3xl md:text-5xl font-bold">para la Minería</span>
      </h1>

      <p class="text-gray-300 text-base md:text-lg leading-relaxed drop-shadow-md max-w-2xl mx-auto">
        Neumáticos OTR, rencauche industrial y asesoría técnica especializada.
      </p>
    </div>

    <div class="relative z-20 flex flex-wrap gap-4 justify-center">
      <a
        href="/#servicios"
        class="flex h-12 px-8 rounded-xl items-center justify-center
               bg-primary text-white font-bold
               hover:bg-primary-dark transition-all hover:scale-105 hover:shadow-xl hover:shadow-primary/30 shadow-lg gap-2 active:scale-[0.97]"
      >
        Nuestros Servicios
        <Icon name="arrow-right" size={20} />
      </a>

      <a
        href="https://wa.me/51930599112?text=Hola%20Rumbomotriz%2C%20me%20gustar%C3%ADa%20recibir%20asesor%C3%ADa%20sobre%20sus%20servicios."
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-12 px-8 rounded-xl items-center justify-center
               bg-white/10 backdrop-blur-sm text-white font-bold border border-white/30
               hover:bg-white/20 transition-all hover:scale-105 shadow-lg gap-2 active:scale-[0.97]"
      >
        <svg viewBox="0 0 32 32" class="w-5 h-5 fill-current" aria-hidden="true"><path d="M16 0C7.163 0 0 7.163 0 16c0 2.837.742 5.49 2.037 7.788L0 32l8.414-2.188A15.93 15.93 0 0016 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm0 29.091c-2.495 0-4.936-.67-7.057-1.94l-.505-.297-4.99 1.297 1.33-4.858-.325-.52A13.03 13.03 0 012.91 16C2.91 8.798 8.798 2.91 16 2.91S29.09 8.798 29.09 16 23.202 29.09 16 29.09zm7.457-9.66c-.407-.203-2.406-1.186-2.777-1.32-.37-.136-.64-.203-.91.203-.27.407-1.05 1.32-1.286 1.59-.237.27-.474.304-.88.101-.407-.203-1.717-.634-3.268-2.023-1.206-1.078-2.02-2.41-2.257-2.817-.237-.407-.025-.627.178-.83.182-.182.407-.474.61-.711.203-.237.27-.407.407-.678.136-.27.068-.508-.034-.711-.102-.203-.91-2.202-1.247-3.014-.337-.813-.678-.703-.91-.711h-.779c-.27 0-.711.101-1.084.508-.372.407-1.422 1.389-1.422 3.387s1.456 3.928 1.659 4.198c.203.27 2.86 4.37 6.92 6.126.967.417 1.722.666 2.31.83.973.31 1.86.267 2.56.162.78-.117 2.406-.983 2.746-1.93.34-.948.34-1.76.237-1.93-.101-.17-.372-.27-.779-.474z"/></svg>
        Cotizar por WhatsApp
      </a>
    </div>


  </div>
</section>

<script>
  setTimeout(() => {
  const slides = document.querySelectorAll('.video-slide');
  let currentSlide = 0;

  function loadVideoSource(slideIndex) {
    const slide = slides[slideIndex];
    if (!slide) return;
    const video = slide.querySelector('video');
    if (video && !video.querySelector('source')) {
      const src = video.getAttribute('data-src');
      if (src) {
        const source = document.createElement('source');
        source.src = src;
        source.type = 'video/mp4';
        video.appendChild(source);
        video.load();
      }
    }
  }

  function nextSlide() {
    slides[currentSlide]?.classList.remove('opacity-100');
    slides[currentSlide]?.classList.add('opacity-0');

    currentSlide = (currentSlide + 1) % slides.length;

    loadVideoSource(currentSlide);

    slides[currentSlide]?.classList.remove('opacity-0');
    slides[currentSlide]?.classList.add('opacity-100');
  }

  if (slides.length > 1) {
    setInterval(nextSlide, 6000);
  }
  }, 500);
</script>
