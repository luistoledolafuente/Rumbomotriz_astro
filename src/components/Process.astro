---
import Icon from "./Icon.astro";

const A = import.meta.env.PUBLIC_ASSETS_URL || '';

const steps = [
  {
    number: "01", icon: "phone", image: `${A}/images/process-diagnosis.webp`,
    title: "Diagnóstico",
    description: "Analizamos su operación y maquinaria para identificar la solución óptima."
  },
  {
    number: "02", icon: "gear", image: `${A}/images/process-proposal.webp`,
    title: "Propuesta Técnica",
    description: "Cotización detallada con especificaciones, plazos y condiciones comerciales."
  },
  {
    number: "03", icon: "truck", image: `${A}/images/process-delivery.webp`,
    title: "Suministro",
    description: "Logística de entrega en su operación o ejecución del servicio certificado."
  },
  {
    number: "04", icon: "headset", image: `${A}/images/process-support.webp`,
    title: "Soporte Continuo",
    description: "Acompañamiento post-venta con inspecciones periódicas."
  }
];
---

<section class="w-full py-20 bg-background" id="proceso" aria-label="Cómo trabajamos">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="reveal mb-16 text-center md:text-left">
      <span class="text-primary font-bold tracking-widest text-sm uppercase mb-2 block">Metodología</span>
      <h2 class="text-foreground text-3xl md:text-4xl font-black leading-tight mb-6">
        Cómo <span class="text-primary">Trabajamos</span>
      </h2>
      <div class="h-1.5 w-20 bg-primary rounded-full mb-6 md:mx-0 mx-auto"></div>
      <p class="text-muted text-lg max-w-2xl md:mx-0 mx-auto">
        Proceso estructurado en 4 etapas para garantizar resultados medibles.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((step, i) => (
        <div class={`reveal reveal-delay-${i + 1} relative flex flex-col rounded-xl bg-surface border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 group`}>
          <div class="relative h-40 overflow-hidden bg-background">
            <img
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              src={step.image}
              alt={step.title}
              width="600"
              height="400"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-surface/80 to-transparent"></div>
            <div class="absolute bottom-3 left-3 inline-flex size-10 items-center justify-center rounded-lg bg-primary/90 text-white shadow">
              <Icon name={step.icon} size={20} />
            </div>
          </div>
          <div class="p-5 flex gap-3 items-start">
            <span class="text-3xl font-black text-primary/20 leading-none shrink-0">{step.number}</span>
            <div>
              <h3 class="text-base font-black text-foreground mb-1">{step.title}</h3>
              <p class="text-muted text-xs leading-relaxed">{step.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
