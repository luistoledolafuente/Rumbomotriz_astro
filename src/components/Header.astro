---
import ThemeToggle from "./ThemeToggle.astro";
import Icon from "./Icon.astro";
---

<header 
  id="main-header"
  class="fixed top-0 left-0 z-50 w-full transition-all duration-500 bg-transparent group"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <a href="/#" class="flex items-center gap-3" aria-label="Ir al inicio">
        <div class="text-primary transition-transform duration-300 hover:scale-110">
          <Icon name="tire" size={36} />
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-black tracking-tighter text-white md:text-foreground group-[.is-scrolled]:text-white leading-none">RUMBO</span>
          <span class="text-sm font-bold tracking-widest text-white/70 md:text-muted group-[.is-scrolled]:text-neutral-300 leading-none">MOTRIZ</span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-8" aria-label="Navegación principal">
        <a class="text-base font-medium text-white group-[.is-scrolled]:text-white hover:text-primary transition-colors" href="/#inicio">Inicio</a>
        <a class="text-base font-medium text-white group-[.is-scrolled]:text-white hover:text-primary transition-colors" href="/#sobre-nosotros">Sobre Nosotros</a>
        <a class="text-base font-medium text-white group-[.is-scrolled]:text-white hover:text-primary transition-colors" href="/#servicios">Servicios</a>
        <a class="text-base font-medium text-white group-[.is-scrolled]:text-white hover:text-primary transition-colors" href="/#proceso">Proceso</a>
        <a class="text-base font-medium text-white group-[.is-scrolled]:text-white hover:text-primary transition-colors" href="/#testimonios">Testimonios</a>
        <a class="text-base font-medium text-white group-[.is-scrolled]:text-white hover:text-primary transition-colors" href="/#contacto">Contacto</a>
      </nav>

      <div class="hidden md:flex items-center gap-4">
        <ThemeToggle />
        <a class="flex min-w-[84px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold hover:bg-primary/90 transition-all hover:shadow-lg hover:shadow-primary/30 active:scale-[0.97]" href="/#contacto">
          Cotizar Ahora
        </a>
      </div>

      <div class="flex md:hidden items-center gap-3 relative z-50">
        <ThemeToggle /> 
        <button id="mobile-menu-btn" class="text-white focus:outline-none p-2 active:scale-[0.92] transition-transform" aria-label="Abrir menú de navegación" type="button">
          <span id="menu-icon"><Icon name="menu" size={28} /></span>
        </button>
      </div>

    </div>
  </div>

  <div id="mobile-menu-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 pointer-events-none opacity-0 transition-opacity duration-300"></div>

  <div id="mobile-menu" class="fixed top-0 right-0 h-full w-80 bg-background shadow-2xl z-40 pointer-events-none translate-x-full transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] p-8">
    <div class="flex flex-col justify-between h-full">
      <nav class="flex flex-col gap-6 mt-16" aria-label="Navegación móvil">
        <a class="mobile-link text-xl font-medium text-foreground hover:text-primary transition-colors flex items-center gap-3" href="/#inicio">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50"></span>
          Inicio
        </a>
        <a class="mobile-link text-xl font-medium text-foreground hover:text-primary transition-colors flex items-center gap-3" href="/#sobre-nosotros">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50"></span>
          Sobre Nosotros
        </a>
        <a class="mobile-link text-xl font-medium text-foreground hover:text-primary transition-colors flex items-center gap-3" href="/#servicios">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50"></span>
          Servicios
        </a>
        <a class="mobile-link text-xl font-medium text-foreground hover:text-primary transition-colors flex items-center gap-3" href="/#proceso">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50"></span>
          Proceso
        </a>
        <a class="mobile-link text-xl font-medium text-foreground hover:text-primary transition-colors flex items-center gap-3" href="/#testimonios">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50"></span>
          Testimonios
        </a>
        <a class="mobile-link text-xl font-medium text-foreground hover:text-primary transition-colors flex items-center gap-3" href="/#contacto">
          <span class="w-1.5 h-1.5 rounded-full bg-primary/50"></span>
          Contacto
        </a>
      </nav>
      <a 
        href="/#contacto"
        class="w-full bg-primary text-white py-3 rounded-xl font-bold text-center text-base hover:bg-primary-dark transition-colors shadow-lg active:scale-[0.97]"
      >
        Cotizar Ahora
      </a>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const header = document.getElementById('main-header');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const menuIcon = document.getElementById('menu-icon');
    const menuLinks = document.querySelectorAll('.mobile-link');

    let isOpen = false;
    let closeTimer = null;

    function updateHeader() {
      if (window.scrollY > 20) {
        header?.classList.add('is-scrolled', 'bg-neutral-950/90', 'backdrop-blur-md', 'shadow-md');
        header?.classList.remove('bg-transparent');
      } else {
        header?.classList.remove('is-scrolled', 'bg-neutral-950/90', 'backdrop-blur-md', 'shadow-md');
        header?.classList.add('bg-transparent');
      }
    }

    function openMenu() {
      if (closeTimer) clearTimeout(closeTimer);
      isOpen = true;
      backdrop?.classList.remove('pointer-events-none', 'opacity-0');
      backdrop?.classList.add('opacity-100');
      menu?.classList.remove('pointer-events-none');
      requestAnimationFrame(() => {
        menu?.classList.remove('translate-x-full');
        menu?.classList.add('translate-x-0');
      });
      if (menuIcon) menuIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      isOpen = false;
      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      menu?.classList.remove('translate-x-0');
      menu?.classList.add('translate-x-full');
      closeTimer = setTimeout(() => {
        menu?.classList.add('pointer-events-none');
      }, 320);
      if (menuIcon) menuIcon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>';
      document.body.style.overflow = '';
    }

    function toggleMenu() {
      isOpen ? closeMenu() : openMenu();
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          updateHeader();
          ticking = false;
        });
        ticking = true;
      }
    });
    updateHeader();

    if (menuBtn && menu) {
      menuBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      backdrop?.addEventListener('click', closeMenu);

      menuLinks.forEach(link => {
        link.addEventListener('click', closeMenu);
      });
    }
  }

  setupHeader();
</script>
