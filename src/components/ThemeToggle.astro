<button
  class="theme-toggle-btn flex size-10 items-center justify-center rounded-full text-foreground hover:bg-muted/10 transition-colors cursor-pointer"
  aria-label="Cambiar modo claro/oscuro"
  title="Cambiar modo claro/oscuro"
>
  <span class="theme-icon block">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
  </span>
</button>

<script>
  function initThemeToggle() {
    const storageKey = 'theme-preference';
    const classDark = 'dark';
    const btnClass = '.theme-toggle-btn';

    function getThemePreference() {
      return document.documentElement.classList.contains(classDark) ? 'dark' : 'light';
    }

    function applyTheme(theme) {
      const isDark = theme === 'dark';
      document.documentElement.classList.toggle(classDark, isDark);
    }

    applyTheme(getThemePreference());

    const buttons = document.querySelectorAll(btnClass);
    buttons.forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', () => {
        const currentTheme = getThemePreference();
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);
        localStorage.setItem(storageKey, newTheme);
      });
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
