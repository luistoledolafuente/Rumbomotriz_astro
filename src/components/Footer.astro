---
import Icon from "./Icon.astro";
---

<footer class="w-full bg-neutral-950 text-white pt-20 pb-8 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      
      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <div class="text-primary">
            <Icon name="tire" size={32} />
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tighter leading-none">RUMBO</span>
            <span class="text-sm font-bold tracking-widest text-neutral-400 leading-none">MOTRIZ</span>
          </div>
        </div>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Expertos en neumáticos mineros y servicios de rencauche industrial. Maximizamos la continuidad de su operación con soluciones integrales.
        </p>
        <div class="flex gap-3">
          <a href="https://wa.me/51930599112" target="_blank" rel="noopener noreferrer" class="flex size-10 items-center justify-center rounded-xl bg-neutral-800 text-neutral-400 hover:bg-primary hover:text-white transition-all" aria-label="WhatsApp">
            <svg viewBox="0 0 32 32" class="w-5 h-5 fill-current"><path d="M16 0C7.163 0 0 7.163 0 16c0 2.837.742 5.49 2.037 7.788L0 32l8.414-2.188A15.93 15.93 0 0016 32c8.837 0 16-7.163 16-16S24.837 0 16 0zm0 29.091c-2.495 0-4.936-.67-7.057-1.94l-.505-.297-4.99 1.297 1.33-4.858-.325-.52A13.03 13.03 0 012.91 16C2.91 8.798 8.798 2.91 16 2.91S29.09 8.798 29.09 16 23.202 29.09 16 29.09zm7.457-9.66c-.407-.203-2.406-1.186-2.777-1.32-.37-.136-.64-.203-.91.203-.27.407-1.05 1.32-1.286 1.59-.237.27-.474.304-.88.101-.407-.203-1.717-.634-3.268-2.023-1.206-1.078-2.02-2.41-2.257-2.817-.237-.407-.025-.627.178-.83.182-.182.407-.474.61-.711.203-.237.27-.407.407-.678.136-.27.068-.508-.034-.711-.102-.203-.91-2.202-1.247-3.014-.337-.813-.678-.703-.91-.711h-.779c-.27 0-.711.101-1.084.508-.372.407-1.422 1.389-1.422 3.387s1.456 3.928 1.659 4.198c.203.27 2.86 4.37 6.92 6.126.967.417 1.722.666 2.31.83.973.31 1.86.267 2.56.162.78-.117 2.406-.983 2.746-1.93.34-.948.34-1.76.237-1.93-.101-.17-.372-.27-.779-.474z"/></svg>
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-lg font-bold uppercase tracking-wider text-primary">Navegación</h3>
        <nav class="flex flex-col gap-3" aria-label="Navegación del footer">
          <a href="/#inicio" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2 group">
            <span class="w-1 h-1 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></span>
            Inicio
          </a>
          <a href="/#sobre-nosotros" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2 group">
            <span class="w-1 h-1 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></span>
            Sobre Nosotros
          </a>
          <a href="/#servicios" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2 group">
            <span class="w-1 h-1 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></span>
            Servicios
          </a>
          <a href="/#proceso" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2 group">
            <span class="w-1 h-1 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></span>
            Proceso
          </a>
          <a href="/#testimonios" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2 group">
            <span class="w-1 h-1 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></span>
            Testimonios
          </a>
          <a href="/#contacto" class="text-neutral-400 hover:text-white transition-colors flex items-center gap-2 group">
            <span class="w-1 h-1 rounded-full bg-primary opacity-0 group-hover:opacity-100 transition-opacity"></span>
            Contacto
          </a>
        </nav>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-lg font-bold uppercase tracking-wider text-primary">Contacto</h3>
        <div class="flex flex-col gap-3">
          <a href="https://wa.me/51930599112" target="_blank" class="flex items-center gap-3 text-neutral-400 hover:text-white transition-colors group">
            <Icon name="phone" size={18} className="text-primary shrink-0 group-hover:text-white transition-colors" />
            <span>+51 930 599 112</span>
          </a>
          <a href="mailto:ventas@rumbomotriz.cl" class="flex items-center gap-3 text-neutral-400 hover:text-white transition-colors group">
            <Icon name="mail" size={18} className="text-primary shrink-0 group-hover:text-white transition-colors" />
            <span>ventas@rumbomotriz.cl</span>
          </a>
          <div class="flex items-start gap-3 text-neutral-400">
            <Icon name="pin" size={18} className="text-primary shrink-0 mt-0.5" />
            <span class="text-sm">Av. Gral. Andrés de Santa Cruz 270,<br/>Jesús María, Lima</span>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        <h3 class="text-lg font-bold uppercase tracking-wider text-primary">Horario</h3>
        <div class="flex flex-col gap-3">
          <div class="flex items-center gap-3 text-neutral-400">
            <Icon name="clock" size={18} className="text-primary shrink-0" />
            <div class="text-sm">
              <p>Lunes a Viernes: <span class="text-white font-medium">8:00 AM - 6:00 PM</span></p>
              <p>Sábados: <span class="text-white font-medium">8:00 AM - 1:00 PM</span></p>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="border-t border-neutral-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-neutral-500">
      <p>© 2024 Rumbomotriz. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href="/#contacto" class="hover:text-white transition-colors">Privacidad</a>
        <a href="/#contacto" class="hover:text-white transition-colors">Términos</a>
      </div>
    </div>

  </div>
</footer>
